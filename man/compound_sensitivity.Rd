% Generated by hand to match R/compound.R.
\name{compound_sensitivity}
\alias{compound_sensitivity}
\title{Compound sensitivity function of a given design}
\usage{
compound_sensitivity(object, components, candidate_set, weights = NULL, ...)
}
\arguments{
\item{object}{a \code{"compound_design"} result, or an \eqn{m \times d}
support matrix (then supply \code{weights}).}

\item{components}{the component list used to build \code{object}, exactly as in
\code{\link{compound_design}}.}

\item{candidate_set}{an \eqn{n \times d} matrix of points to scan.}

\item{weights}{weights, when \code{object} is a bare support matrix.}

\item{...}{further arguments passed to \code{\link{compound_criterion}}
(\code{alpha}, \code{psi_star}, \code{efficiency}, \code{factor_levels},
\code{xi0_points}, \code{xi0_weights}, \code{n0}, \code{n1}, ...).}
}
\value{
A list with \code{sensitivity} (one value per candidate), \code{max_d},
\code{index} (the maximising candidate), \code{criterion} and \code{euler}
(the residual of the Euler identity \eqn{\sum_j \mathrm{tr}(K_j M_j) =
\Psi_\alpha}, which should be numerically zero).
}
\description{
Evaluates the compound sensitivity function of a \code{\link{compound_design}}
result over a candidate set --- the quantity the compound equivalence theorem
bounds by zero. Useful for checking a design the package did not compute, or
for verifying a result on a finer grid than the one it was found on.
}
\details{
At the optimum the sensitivity is \eqn{\le 0} everywhere and \eqn{= 0} on the
support, so \code{max_d} is the natural certificate. A positive \code{max_d}
together with a numerically exact \code{euler} residual indicates an
unconverged design rather than a failure of the theorem.
}
\seealso{
\code{\link{compound_design}}.
}
